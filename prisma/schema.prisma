generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Users {
  id       Int        @id @default(autoincrement())
  name     String
  login    String     @unique
  password String
  workouts Workouts[]
  isAdmin  Boolean    @default(false) @map("is_admin")
}

enum MuscleGroup {
  PEITO
  COSTAS
  OMBRO
  TRICEPS
  BICEPS
  PANTURRILHA
  QUADRICEPS
  POSTERIOR
  ABS
}

model Exercises {
  id               Int                 @id @default(autoincrement())
  name             String
  muscleGroup      MuscleGroup         @map("muscle_group")
  workoutExercises Workout_Exercises[]
}

model Workouts {
  id               Int                 @id @default(autoincrement())
  user             Users               @relation(fields: [userId], references: [id])
  userId           Int                 @map("user_id")
  name             String
  description      String
  weekDay          WeekDay             @map("week_day")
  workoutExercises Workout_Exercises[]
}

enum WeekDay {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

model Workout_Exercises {
  id         Int       @id @default(autoincrement())
  workout    Workouts  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  workoutId  Int       @map("workout_id")
  exercise   Exercises @relation(fields: [exerciseId], references: [id])
  exerciseId Int       @map("exercise_id")
  sets       Int
  reps       Int
  weight     Int
}
